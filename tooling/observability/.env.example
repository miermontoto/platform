# copiar a .env (gitignored). usuario root de openobserve: lo usan la ui, obs.sh y
# (en base64) el OTEL_EXPORTER_OTLP_HEADERS de cada app.
ZO_ROOT_USER_EMAIL=admin@example.com
# política de openobserve: 8-128 caracteres con minúscula, mayúscula, dígito y símbolo
# (si no, el contenedor no arranca)
ZO_ROOT_USER_PASSWORD=
# retención en días (default 14)
O2_RETENTION_DAYS=14
